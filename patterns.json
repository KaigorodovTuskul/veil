[
  {
    "name": "Email",
    "type": "EMAIL",
    "regex": "(?<![\\w.-])[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}(?![\\w.-])"
  },
  {
    "name": "Телефон",
    "type": "PHONE",
    "regex": "(?<!\\d)(?:\\+?7|8)[\\s().-]*\\d{3}[\\s().-]*\\d{3}[\\s.-]*\\d{2}[\\s.-]*\\d{2}(?!\\d)"
  },
  {
    "name": "ИНН",
    "type": "INN",
    "regex": "(?<!\\d)(?:\\d{10}|\\d{12})(?!\\d)"
  },
  {
    "name": "СНИЛС",
    "type": "SNILS",
    "regex": "(?<!\\d)\\d{3}-\\d{3}-\\d{3}\\s?\\d{2}(?!\\d)"
  },
  {
    "name": "Паспорт",
    "type": "PASSPORT",
    "regex": "(?<!\\d)\\d{4}\\s?\\d{6}(?!\\d)"
  },
  {
    "name": "Имя или ФИО по контексту",
    "type": "PERSON",
    "regex": "(?:(?i:ФИО|имя|клиент|директор|владелец|заемщик|получатель))[ \\t]*[:№-]?[ \\t]*(?P<value>[А-ЯЁA-Z][а-яёa-z-]+(?:[ \\t]+[А-ЯЁA-Z][а-яёa-z-]+){1,2})",
    "value_group": "value"
  },
  {
    "name": "Адрес по контексту",
    "type": "ADDRESS",
    "regex": "(?:(?i:адрес|проживает|место регистрации|регистрация))[ \\t]*[:№-]?[ \\t]*(?P<value>[^,;\\n]{5,80}(?:,[ \\t]*[^,;\\n]{1,40}){0,3})",
    "value_group": "value"
  },
  {
    "name": "API-ключ или токен",
    "type": "SECRET",
    "regex": "(?i)\\b(?:api[_-]?key|token|secret|sk|pk)[=: _-]+[A-Za-z0-9_-]{16,}\\b"
  }
]
