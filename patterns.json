[
  {
    "name": "Email",
    "type": "EMAIL",
    "regex": "(?<![\\w.-])[\\w.+-]+@(?:[\\w-]+\\.)+[A-Za-z]{2,}(?![\\w-])"
  },
  {
    "name": "Телефон",
    "type": "PHONE",
    "regex": "(?<!\\d)(?:\\+?7|8)[\\s().-]*\\d{3}[\\s().-]*\\d{3}[\\s.-]*\\d{2}[\\s.-]*\\d{2}(?!\\d)"
  },
  {
    "name": "ИНН",
    "type": "INN",
    "regex": "(?<!\\d)(?:\\d{10}|\\d{12})(?!\\d)"
  },
  {
    "name": "СНИЛС",
    "type": "SNILS",
    "regex": "(?<!\\d)\\d{3}-\\d{3}-\\d{3}\\s?\\d{2}(?!\\d)"
  },
  {
    "name": "Паспорт",
    "type": "PASSPORT",
    "regex": "(?<!\\d)\\d{4}\\s?\\d{6}(?!\\d)"
  },
  {
    "name": "Имя или ФИО по контексту",
    "type": "PERSON",
    "regex": "(?:(?i:ФИО|имя(?:[ \\t]+клиента)?|клиент|директор|владелец|заемщик|получатель))[ \\t]*[:№-]?[ \\t]*(?P<value>[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+(?:[ \\t]+[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+){0,2})",
    "value_group": "value"
  },
  {
    "name": "Адрес по контексту",
    "type": "ADDRESS",
    "regex": "(?:(?i:адрес(?:[ \\t]+(?:регистрации|доставки|проживания|места регистрации))?|проживает|место регистрации|регистрация))[ \\t]*[:№-]?[ \\t]*(?P<value>[^,;\\n]{5,80}(?:,[ \\t]*[^,;\\n]{1,40}){0,5})",
    "value_group": "value"
  },
  {
    "name": "API-ключ или токен",
    "type": "SECRET",
    "regex": "(?i)\\b(?:api[_-]?key|token|secret|sk|pk)[=: _-]+[A-Za-z0-9_-]{16,}\\b"
  },
  {
    "name": "City by context",
    "type": "CITY",
    "regex": "(?:(?i:\\b(?:г\\.|гор\\.|город|в городе)\\b))[ \\t]+(?P<value>[А-ЯЁA-Z][а-яёa-z-]+(?:[ \\t]+[А-ЯЁA-Z][а-яёa-z-]+){0,2})",
    "value_group": "value"
  },
  {
    "name": "Country",
    "type": "COUNTRY",
    "regex": "(?P<value>(?i:Российская Федерация|России|Россия|Республики Беларусь|Республика Беларусь|Беларусь|Республика Казахстан|Казахстан|Китайская Народная Республика|Китай|United States of America|United States|Germany))(?=[.,;!?]|$)",
    "value_group": "value"
  },
  {
    "name": "Region by context",
    "type": "REGION",
    "regex": "(?:(?i:\\b(?:в|из|к|по|на|около)\\b))[ \\t]+(?P<value>[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+[ \\t]+(?i:области|область|обл\\.|крае|край|республике|республика|округе|округ))",
    "value_group": "value"
  },
  {
    "name": "Region without context",
    "type": "REGION",
    "regex": "(?P<value>(?:(?i:республика|республики|республике)[ \\t]+[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+(?:[ \\t]+[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+){0,2}|[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+[ \\t]+(?i:область|области|обл\\.|край|крае|округ|округе)))(?=[.,;!?\\n]|$)",
    "value_group": "value"
  },
  {
    "name": "City by preposition",
    "type": "CITY",
    "regex": "(?:(?i:\\b(?:в|из|к|по|на|около)\\b))[ \\t]+(?P<value>(?!(?i:банк\\w*|правлени\\w*|политик\\w*|положени\\w*|систем\\w*|фонд\\w*|совет\\w*|документ\\w*|организаци\\w*|компани\\w*))[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+(?:[ \\t]+[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+){0,2})(?=[.,;!?]|$)",
    "value_group": "value"
  },
  {
    "name": "Organization by context",
    "type": "ORGANIZATION",
    "regex": "(?:(?i:организаци\\w*|компани\\w*|заказчик\\w*|исполнитель\\w*|поставщик\\w*|работодатель\\w*))[ \\t]*[:№-]?[ \\t]*(?P<value>[«\"']?[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z0-9-]*[»\"']?(?:[ \\t]+[«\"']?[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z0-9-]*[»\"']?){0,5})",
    "value_group": "value"
  },
  {
    "name": "Organization by name suffix",
    "type": "ORGANIZATION",
    "regex": "(?<![\\w-])(?P<value>[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]{2,}(?:[ \\t]+[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]{2,}){0,2}[ \\t]*(?i:банк|холдинг|группа|фонд|университет|институт|компания|корпорация|организация|администрация|министерство|агентство|предприятие))(?=$|[.,;:!?()\\]\\}])",
    "value_group": "value"
  },
  {
    "name": "Organization legal form",
    "type": "ORGANIZATION",
    "regex": "(?P<value>(?:ООО|АО|ПАО|ОАО|ЗАО|ИП|АКБ|LLC|LTD|INC)[ \\t]+[«\"']?[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z0-9-]*[»\"']?(?:[ \\t]+[«\"']?[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z0-9-]*[»\"']?){0,4}(?:[ \\t]+(?:ООО|АО|ПАО|ОАО|ЗАО|ИП|LLC|LTD|INC))?)",
    "value_group": "value"
  },
  {
    "name": "Organization legal name",
    "type": "ORGANIZATION",
    "regex": "(?P<value>(?i:акционерное общество|общество с ограниченной ответственностью|публичное акционерное общество|закрытое акционерное общество)[ \\t]+[«\"'][^«»\"'\\n]{2,100}[»\"'])",
    "value_group": "value"
  },
  {
    "name": "Organization with initials",
    "type": "ORGANIZATION",
    "regex": "(?P<value>(?i:ИП|ООО|АО|ПАО|ОАО|ЗАО)[ \\t]+[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+(?:[ \\t]+[А-ЯЁA-Z]\\.){1,2})",
    "value_group": "value"
  },
  {
    "name": "Foreign organization legal form",
    "type": "ORGANIZATION",
    "regex": "(?P<value>[A-Za-z][A-Za-z0-9&.-]*(?:[ \\t]+[A-Za-z][A-Za-z0-9&.-]*){0,4}[ \\t]+(?i:LLC|LTD\\.?|INC\\.?|CORPORATION|CORP\\.?))",
    "value_group": "value"
  },
  {
    "name": "Organization quoted legal name",
    "type": "ORGANIZATION",
    "regex": "(?P<value>[«\"'][А-ЯЁA-Z][^«»\"'\\n]{1,80}[»\"'][ \\t]+(?:ООО|АО|ПАО|ОАО|ЗАО|ИП|LLC|LTD|INC|Открытое|Закрытое|Публичное|Непубличное|акционерное|общество|с ограниченной ответственностью)(?:[ \\t]+[А-Яа-яЁёA-Za-z-]+){0,4})",
    "value_group": "value"
  },
  {
    "name": "Address abbreviation",
    "type": "ADDRESS",
    "regex": "(?P<value>(?:(?i:ул\\.|улица|пр-т|проспект|пер\\.|переулок|наб\\.|набережная|ш\\.|площадь|пл\\.))[ \\t]*[^\\n;]{5,120})",
    "value_group": "value"
  },
  {
    "name": "Person by role",
    "type": "PERSON",
    "regex": "(?:(?i:г-н|г-жа|господин|госпожа|гражданин|сотрудник|работник|представитель|заявитель|директор|начальник))[ \\t]*[:№-]?[ \\t]+(?P<value>[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+(?:[ \\t]+[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+){1,2})",
    "value_group": "value"
  },
  {
    "name": "Person with initials",
    "type": "PERSON",
    "regex": "(?:(?i:подписант|согласовано|сотрудник|заявитель|ФИО))[ \\t]*[:№-]?[ \\t]*(?P<value>[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+[ \\t]+[А-ЯЁ]\\.[ \\t]*[А-ЯЁ]\\.)",
    "value_group": "value"
  },
  {
    "name": "Person after action",
    "type": "PERSON",
    "regex": "(?:(?i:в тексте|назначили|передать документы|документ подписан|согласовано с))[ \\t:,-]+(?P<value>[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+(?:[ \\t]+[А-ЯЁA-Z][А-ЯЁа-яёA-Za-z-]+){2})",
    "value_group": "value"
  }
]
